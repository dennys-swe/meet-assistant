# ===== GEMINI API CONFIGURATION =====
# Obtenha sua chave em: https://aistudio.google.com/app/apikeys
# IMPORTANTE: Nunca versione .env com chave real! Use .env.local ou use GitHub Secrets
GEMINI_API_KEY=your-gemini-api-key-here

# ===== AUDIO DEVICE CONFIGURATION =====
# Índice do device de áudio (0 = padrão, 1-N = outros devices)
# Verifique com: python -c "import pyaudio; p=pyaudio.PyAudio(); [print(i, p.get_device_info_by_index(i)['name']) for i in range(p.get_device_count())]"
DEVICE_INDEX=0

# ===== WHISPER & GEMINI TUNING =====
# Confidence threshold para Google Speech Recognition (0.0 a 1.0)
# Valores mais altos = menos alucinações, mais silêncios ignorados
CONFIDENCE_THRESHOLD=0.85

# ===== OBSIDIAN PATH =====
# Caminho para salvar resumos das aulas (Windows: use \\ ou /)
OBSIDIAN_PATH=C:/Users/SeuNome/OneDrive/Documentos/Obsidian
